<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ProjekAstra.Controller.Dashboard.DashboardKaryawan"
            styleClass="bg-soft"
            stylesheets="@../css/villa-theme.css">

    <left>
        <VBox prefWidth="220" spacing="5" styleClass="sidebar">
            <padding><Insets top="20" bottom="20" left="15" right="15"/></padding>

            <Label text="🏠 VillaStay 🏠" styleClass="sidebar-title">
                <font><Font name="System Bold" size="22"/></font>
            </Label>
            <Label text="Dashboard Karyawan" styleClass="sidebar-subtitle" style="-fx-font-size: 11px;"/>

            <Region prefHeight="25"/>

            <!-- ===== DATA MASTER ===== -->
            <Label text="📋 DATA MASTER" style="-fx-text-fill: #9FA8DA; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 10 0 5 10;"/>

            <Button fx:id="btnKaryawan" text="👤 Karyawan" onAction="#handleKaryawan"
                    prefWidth="190" prefHeight="40" alignment="CENTER_LEFT"
                    style="-fx-background-color: white; -fx-text-fill: #1565C0; -fx-background-radius: 8; -fx-font-weight: bold; -fx-cursor: hand;"/>

            <Region prefHeight="5"/>

            <Button fx:id="btnPenyewa" text="🧑 Penyewa" onAction="#handlePenyewa"
                    prefWidth="190" prefHeight="40" alignment="CENTER_LEFT"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold; -fx-cursor: hand;"/>

            <Region prefHeight="5"/>

            <Button fx:id="btnVilla" text="🏡 Villa" onAction="#handleVilla"
                    prefWidth="190" prefHeight="40" alignment="CENTER_LEFT"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold; -fx-cursor: hand;"/>

            <Region prefHeight="5"/>

            <Button fx:id="btnKategori" text="📂 Kategori Villa" onAction="#handleKategori"
                    prefWidth="190" prefHeight="40" alignment="CENTER_LEFT"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold; -fx-cursor: hand;"/>

            <Region prefHeight="5"/>

            <Button fx:id="btnFasilitas" text="🛋️ Fasilitas" onAction="#handleFasilitas"
                    prefWidth="190" prefHeight="40" alignment="CENTER_LEFT"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold; -fx-cursor: hand;"/>

            <Region prefHeight="8"/>
            <Separator style="-fx-background-color: #3949AB;"/>
            <Region prefHeight="8"/>

            <!-- ===== TRANSAKSI ===== -->
            <Label text="💳 TRANSAKSI" style="-fx-text-fill: #9FA8DA; -fx-font-size: 11px; -fx-font-weight: bold; -fx-padding: 10 0 5 10;"/>

            <Button fx:id="btnTransaksiBooking" text="📅 Booking" onAction="#handleTransaksiBooking"
                    prefWidth="190" prefHeight="40" alignment="CENTER_LEFT"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold; -fx-cursor: hand;"/>

            <Region prefHeight="5"/>

            <Button fx:id="btnTransaksiRefund" text="↩️ Refund" onAction="#handleTransaksiRefund"
                    prefWidth="190" prefHeight="40" alignment="CENTER_LEFT"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-background-radius: 8; -fx-font-weight: bold; -fx-cursor: hand;"/>

            <Region prefHeight="8"/>
            <Separator style="-fx-background-color: #3949AB;"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Label text="VillaStay v2.0" style="-fx-text-fill: #5C6BC0; -fx-font-size: 10px; -fx-alignment: CENTER; -fx-padding: 10 0 0 0;"/>
        </VBox>
    </left>

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="70" styleClass="topbar">
            <padding><Insets left="25" right="25"/></padding>

            <Label fx:id="lblJudul" text="Dashboard" styleClass="page-title">
                <font><Font name="System Bold" size="18"/></font>
            </Label>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="🚪 Keluar" onAction="#handleLogout" prefHeight="35" prefWidth="90"
                    styleClass="btn-danger"/>
        </HBox>
    </top>

    <center>
        <StackPane fx:id="contentPane">
            <padding><Insets top="20" bottom="20" left="20" right="20"/></padding>
        </StackPane>
    </center>

</BorderPane>