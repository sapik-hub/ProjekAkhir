<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ProjekAstra.Controller.Dashboard.DashboardPenyewa"
            styleClass="bg-soft"
            stylesheets="@../css/villa-theme.css">

    <top>
        <HBox alignment="CENTER_LEFT" prefHeight="70" styleClass="topbar">
            <padding><Insets left="25" right="25"/></padding>
            <Label fx:id="lblJudul" text="Dashboard" styleClass="page-title">
                <font><Font name="System Bold" size="18"/></font>
            </Label>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Keluar" onAction="#handleLogout" prefHeight="35" prefWidth="90"
                    styleClass="btn-danger"/>
        </HBox>
    </top>

    <center>
        <StackPane fx:id="contentPane">

            <!-- ===== LAYAR 1: Grid bubble villa + search ===== -->
            <VBox fx:id="mainView" spacing="20" alignment="TOP_CENTER" styleClass="kiosk-main">
                <padding><Insets top="25" bottom="15" left="30" right="30"/></padding>

                <Label text="🏡 Pilih Villa Kamu 🏡" styleClass="welcome-text" style="-fx-font-size: 20px;"/>

                <HBox spacing="10" alignment="CENTER_LEFT" styleClass="search-bar" maxWidth="Infinity">
                    <TextField fx:id="txtCari" promptText="Cari nama villa atau kapasitas (mis. 6)"
                               prefWidth="380" styleClass="search-field"/>
                    <Button text="🔍 Cari" onAction="#handleCari" styleClass="btn-search"/>
                    <Button text="✖ Reset" onAction="#handleResetCari" styleClass="btn-reset"/>
                </HBox>

                <ScrollPane fitToWidth="true" styleClass="bubble-scroll" VBox.vgrow="ALWAYS">
                    <FlowPane fx:id="bubbleContainer" hgap="28" vgap="28" alignment="CENTER" styleClass="bubble-flow">
                        <padding><Insets top="15" bottom="30"/></padding>
                    </FlowPane>
                </ScrollPane>
            </VBox>

            <!-- ===== LAYAR 2: Overlay (detail villa / verifikasi / registrasi / form booking) ===== -->
            <StackPane fx:id="overlayPane" styleClass="overlay-dim" visible="false" managed="false">

                <!-- BUBBLE 1: Detail villa -->
                <VBox fx:id="detailBubble" styleClass="detail-bubble" alignment="CENTER" spacing="10"
                      maxWidth="440" maxHeight="620" prefWidth="440">
                    <padding><Insets top="35" bottom="30" left="35" right="35"/></padding>

                    <ImageView fx:id="imgDetailFoto" fitWidth="200" fitHeight="150" preserveRatio="false"/>

                    <Label fx:id="lblDetailStatus" styleClass="detail-status-badge"/>
                    <Label fx:id="lblDetailNama" styleClass="detail-title"/>
                    <Label fx:id="lblDetailKategori" styleClass="detail-sub"/>
                    <Label fx:id="lblDetailKapasitas" styleClass="detail-sub"/>
                    <Label fx:id="lblDetailHargaWeekday" styleClass="detail-harga"/>
                    <Label fx:id="lblDetailHargaWeekend" styleClass="detail-harga"/>

                    <Separator/>

                    <Label text="Alamat:" styleClass="detail-label-kecil"/>
                    <Label fx:id="lblDetailAlamat" styleClass="detail-desc" wrapText="true"/>

                    <Label text="Pemilik:" styleClass="detail-label-kecil"/>
                    <Label fx:id="lblDetailPemilik" styleClass="detail-desc"/>

                    <Label text="Fasilitas:" styleClass="detail-label-kecil"/>
                    <FlowPane fx:id="fasilitasContainer" hgap="8" vgap="8" styleClass="fasilitas-flow"/>

                    <Region VBox.vgrow="ALWAYS"/>

                    <HBox spacing="15" alignment="CENTER">
                        <Button text="⬅ Kembali" onAction="#handleKembaliBubble" styleClass="btn-kembali" prefWidth="150"/>
                        <Button text="📖 Booking" onAction="#handleMulaiVerifikasi" styleClass="btn-booking" prefWidth="150"/>
                    </HBox>
                </VBox>

                <!-- BUBBLE 2: Verifikasi penyewa (sudah pernah / belum pernah) -->
                <VBox fx:id="verifBubble" styleClass="detail-bubble" alignment="CENTER" spacing="16"
                      maxWidth="420" maxHeight="420" prefWidth="420" visible="false" managed="false">
                    <padding><Insets top="35" bottom="30" left="35" right="35"/></padding>

                    <Label text="👋 Selamat Datang!" styleClass="detail-title"/>
                    <Label text="Apakah Anda sudah pernah booking di sini sebelumnya?"
                           styleClass="detail-sub" wrapText="true" textAlignment="CENTER"/>

                    <HBox spacing="15" alignment="CENTER">
                        <Button text="Sudah Pernah" onAction="#handlePilihSudahPernah" styleClass="btn-booking" prefWidth="170"/>
                        <Button text="Belum Pernah" onAction="#handlePilihBelumPernah" styleClass="btn-kembali" prefWidth="170"/>
                    </HBox>

                    <Separator/>

                    <Label text="Masukkan Nomor Telepon Anda" styleClass="detail-label-kecil"/>
                    <TextField fx:id="txtNoTeleponCari" styleClass="input-field" promptText="08xxxxxxxxxx" maxWidth="Infinity"/>

                    <Region VBox.vgrow="ALWAYS"/>

                    <Button text="⬅ Kembali" onAction="#handleKembaliDariVerif" styleClass="btn-kembali" maxWidth="Infinity"/>
                </VBox>

                <!-- BUBBLE 3: Registrasi penyewa baru -->
                <VBox fx:id="registrasiBubble" styleClass="detail-bubble" alignment="CENTER" spacing="10"
                      maxWidth="440" maxHeight="640" prefWidth="440" visible="false" managed="false">
                    <padding><Insets top="30" bottom="25" left="35" right="35"/></padding>

                    <Label text="Isi Data Diri" styleClass="detail-title"/>
                    <Label text="Data ini akan disimpan untuk booking Anda" styleClass="detail-sub"/>

                    <Label text="Nama Lengkap" styleClass="detail-label-kecil"/>
                    <TextField fx:id="txtRegNama" styleClass="input-field"/>

                    <Label text="Nomor Telepon" styleClass="detail-label-kecil"/>
                    <TextField fx:id="txtRegNoTelp" styleClass="input-field"/>

                    <Label text="Nomor KTP" styleClass="detail-label-kecil"/>
                    <TextField fx:id="txtRegNoKtp" styleClass="input-field"/>

                    <Label text="Tanggal Lahir" styleClass="detail-label-kecil"/>
                    <DatePicker fx:id="dpRegTglLahir" styleClass="input-field" maxWidth="Infinity"/>

                    <Label text="Alamat" styleClass="detail-label-kecil"/>
                    <TextArea fx:id="txtRegAlamat" styleClass="input-field" prefHeight="55" wrapText="true"/>

                    <Region VBox.vgrow="ALWAYS"/>

                    <HBox spacing="15" alignment="CENTER">
                        <Button text="⬅ Kembali" onAction="#handleKembaliDariRegistrasi" styleClass="btn-kembali" prefWidth="150"/>
                        <Button text="Simpan &amp; Lanjut" onAction="#handleSimpanRegistrasi" styleClass="btn-booking" prefWidth="180"/>
                    </HBox>
                </VBox>

                <!-- BUBBLE 4: Form booking (identitas penyewa sudah otomatis dari verifikasi/registrasi) -->
                <VBox fx:id="bookingPane" styleClass="detail-bubble" alignment="CENTER" spacing="12"
                      maxWidth="440" maxHeight="680" prefWidth="440" visible="false" managed="false">

                    <padding><Insets top="35" bottom="30" left="35" right="35"/></padding>

                    <Label text="Form Booking Villa" styleClass="detail-title"/>
                    <Label fx:id="lblVillaTerpilih" styleClass="detail-sub" wrapText="true"/>

                    <Label text="Atas Nama" styleClass="detail-label-kecil"/>
                    <Label fx:id="lblPenyewaAktif" styleClass="detail-harga" wrapText="true"/>

                    <Label text="Alamat" styleClass="detail-label-kecil"/>
                    <TextArea fx:id="txtAlamatBooking" styleClass="input-field" prefHeight="50" wrapText="true"/>

                    <HBox spacing="12">
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Check-In" styleClass="detail-label-kecil"/>
                            <DatePicker fx:id="dpCheckin" styleClass="input-field" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Check-Out" styleClass="detail-label-kecil"/>
                            <DatePicker fx:id="dpCheckout" styleClass="input-field" maxWidth="Infinity"/>
                        </VBox>
                    </HBox>

                    <Label text="Jumlah Tamu" styleClass="detail-label-kecil"/>
                    <TextField fx:id="txtJumlahTamu" styleClass="input-field"/>

                    <Label text="Metode Pembayaran" styleClass="detail-label-kecil"/>
                    <ComboBox fx:id="cbMetodePembayaran" styleClass="input-field" maxWidth="Infinity" promptText="Pilih metode pembayaran..."/>

                    <Label text="Catatan (opsional)" styleClass="detail-label-kecil"/>
                    <TextArea fx:id="txtCatatan" styleClass="input-field" prefHeight="45" wrapText="true"/>

                    <Label fx:id="lblGrandHarga" styleClass="detail-harga"/>

                    <Region VBox.vgrow="ALWAYS"/>

                    <HBox spacing="15" alignment="CENTER">
                        <Button text="⬅ Kembali" onAction="#handleKembaliBooking" styleClass="btn-kembali" prefWidth="150"/>
                        <Button text="📖 Booking Sekarang" onAction="#handleBookingSekarang" styleClass="btn-booking" prefWidth="180"/>
                    </HBox>
                </VBox>

            </StackPane>

        </StackPane>
    </center>

</BorderPane>