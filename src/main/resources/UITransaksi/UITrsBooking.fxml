<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ProjekAstra.Controller.Transaksi.Booking"
            styleClass="bg-soft"
            stylesheets="@../css/villa-theme.css">

    <center>
        <HBox spacing="15">
            <padding><Insets top="0" bottom="15" left="0" right="0"/></padding>

            <!-- FORM KIRI -->
            <VBox spacing="10" prefWidth="320" styleClass="card">
                <padding><Insets top="20" bottom="20" left="20" right="20"/></padding>

                <Label text="Transaksi Booking" styleClass="brand-title">
                    <font><Font name="System Bold" size="15"/></font>
                </Label>

                <TextField fx:id="txtId" promptText="Id Booking" editable="false" styleClass="input-field"/>

                <ComboBox fx:id="cbPenyewa" promptText="Pilih Penyewa..." maxWidth="Infinity" styleClass="input-field"/>
                <ComboBox fx:id="cbVilla" promptText="Pilih Villa..." maxWidth="Infinity" styleClass="input-field"/>

                <HBox spacing="8">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Check-In" styleClass="detail-label-kecil"/>
                        <DatePicker fx:id="dpCheckin" maxWidth="Infinity" styleClass="input-field"/>
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Check-Out" styleClass="detail-label-kecil"/>
                        <DatePicker fx:id="dpCheckout" maxWidth="Infinity" styleClass="input-field"/>
                    </VBox>
                </HBox>

                <TextField fx:id="txtJumlahTamu" promptText="Jumlah Tamu" styleClass="input-field"/>
                <TextField fx:id="txtGrandHarga" promptText="Grand Harga" editable="false" styleClass="input-field"/>

                <TextArea fx:id="txtCatatan" promptText="Catatan Penyewa" prefRowCount="3" wrapText="true" styleClass="input-field"/>

                <Label text="Status Booking" styleClass="detail-label-kecil"/>
                <ComboBox fx:id="cbStatus" promptText="Pilih status..." maxWidth="Infinity" styleClass="input-field"/>

                <Region VBox.vgrow="ALWAYS"/>
                <TextField fx:id="txtCari" promptText="🔍 Cari nama penyewa / id booking..." styleClass="input-field"/>
            </VBox>

            <!-- TABEL KANAN -->
            <VBox HBox.hgrow="ALWAYS" styleClass="card">
                <padding><Insets top="15" bottom="15" left="15" right="15"/></padding>

                <TableView fx:id="tableBooking" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" text="Id Booking" prefWidth="90"/>
                        <TableColumn fx:id="colPenyewa" text="Penyewa" prefWidth="140"/>
                        <TableColumn fx:id="colVilla" text="Villa" prefWidth="130"/>
                        <TableColumn fx:id="colCheckin" text="Check-In" prefWidth="90"/>
                        <TableColumn fx:id="colCheckout" text="Check-Out" prefWidth="90"/>
                        <TableColumn fx:id="colTamu" text="Tamu" prefWidth="60"/>
                        <TableColumn fx:id="colHarga" text="Grand Harga" prefWidth="110"/>
                        <TableColumn fx:id="colStatus" text="Status" prefWidth="120"/>
                    </columns>
                </TableView>
            </VBox>
        </HBox>
    </center>

    <bottom>
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="card">
            <padding><Insets top="15" bottom="15" left="20" right="20"/></padding>

            <Button fx:id="btnSimpan" text="Simpan" onAction="#handleSimpan"
                    styleClass="btn-primary" prefWidth="110"/>
            <Button fx:id="btnUbah" text="Ubah" onAction="#handleUbah"
                    styleClass="btn-warning" prefWidth="110"/>
            <Button fx:id="btnHapus" text="Batalkan" onAction="#handleHapus"
                    styleClass="btn-danger" prefWidth="110"/>
            <Button text="Reset" onAction="#handleReset"
                    styleClass="btn-neutral" prefWidth="100"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="🖨 Cetak Struk" onAction="#handleCetakStruk"
                    styleClass="btn-booking" prefWidth="140"/>
        </HBox>
    </bottom>

</BorderPane>