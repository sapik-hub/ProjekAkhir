<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ProjekAstra.Controller.Transaksi.Refund"
            prefHeight="700.0"
            prefWidth="1200.0"
            style="-fx-background-color: #4A3A30;">

    <!-- ===================================================== -->
    <!-- AREA UTAMA -->
    <!-- ===================================================== -->

    <HBox spacing="16"
          AnchorPane.topAnchor="20"
          AnchorPane.bottomAnchor="80"
          AnchorPane.leftAnchor="30"
          AnchorPane.rightAnchor="30">

        <!-- ================================================= -->
        <!-- CARD FORM REFUND -->
        <!-- ================================================= -->

        <VBox spacing="10"
              prefWidth="280"
              minWidth="280"
              maxWidth="280"
              style="-fx-background-color: #FFFDF7;
                     -fx-background-radius: 20;
                     -fx-border-radius: 20;">

            <padding>
                <Insets top="20"
                        right="20"
                        bottom="20"
                        left="20"/>
            </padding>

            <Label text="Form Refund"
                   style="-fx-font-size: 18px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #333333;"/>

            <Label text="ID Refund"
                   style="-fx-text-fill: #555555;"/>

            <TextField fx:id="txtId"
                       editable="false"
                       prefHeight="38"/>

            <Label text="Booking"
                   style="-fx-text-fill: #555555;"/>

            <ComboBox fx:id="cbBooking"
                      prefWidth="240"
                      prefHeight="38"/>

            <Label text="Karyawan"
                   style="-fx-text-fill: #555555;"/>

            <ComboBox fx:id="cbKaryawan"
                      prefWidth="240"
                      prefHeight="38"/>

            <Label text="Alasan Refund"
                   style="-fx-text-fill: #555555;"/>

            <TextArea fx:id="txtAlasan"
                      prefHeight="60"
                      wrapText="true"/>

            <Label text="Jumlah Refund"
                   style="-fx-text-fill: #555555;"/>

            <TextField fx:id="txtJumlahRefund"
                       prefHeight="38"/>

            <Label text="Tanggal Pengajuan"
                   style="-fx-text-fill: #555555;"/>

            <DatePicker fx:id="dpPengajuan"
                        prefWidth="240"
                        prefHeight="38"/>

            <Label text="Tanggal Refund"
                   style="-fx-text-fill: #555555;"/>

            <DatePicker fx:id="dpRefund"
                        prefWidth="240"
                        prefHeight="38"/>

            <Label text="Deskripsi"
                   style="-fx-text-fill: #555555;"/>

            <TextArea fx:id="txtDeskripsi"
                      prefHeight="60"
                      wrapText="true"/>

            <Label text="Status Refund"
                   style="-fx-text-fill: #555555;"/>

            <ComboBox fx:id="cbStatus"
                      prefWidth="240"
                      prefHeight="38"/>

            <Label text="Cari Refund"
                   style="-fx-text-fill: #555555;"/>

            <TextField fx:id="txtCari"
                       promptText="Cari ID Refund / Booking..."
                       prefHeight="38"/>

        </VBox>


        <!-- ================================================= -->
        <!-- CARD TABLE REFUND -->
        <!-- ================================================= -->

        <VBox HBox.hgrow="ALWAYS"
              style="-fx-background-color: #FFFDF7;
                     -fx-background-radius: 20;
                     -fx-border-radius: 20;">

            <padding>
                <Insets top="18"
                        right="18"
                        bottom="18"
                        left="18"/>
            </padding>

            <TableView fx:id="tableRefund"
                       VBox.vgrow="ALWAYS"
                       style="-fx-background-color: white;
                              -fx-control-inner-background: white;
                              -fx-table-cell-border-color: #E0E0E0;
                              -fx-border-color: #D6D6D6;
                              -fx-border-width: 1;">

                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>

                <columns>

                    <TableColumn fx:id="colId"
                                 text="ID Refund"
                                 prefWidth="110"/>

                    <TableColumn fx:id="colBooking"
                                 text="Booking"
                                 prefWidth="110"/>

                    <TableColumn fx:id="colKaryawan"
                                 text="Karyawan"
                                 prefWidth="140"/>

                    <TableColumn fx:id="colJumlah"
                                 text="Jumlah"
                                 prefWidth="100"/>

                    <TableColumn fx:id="colPengajuan"
                                 text="Pengajuan"
                                 prefWidth="110"/>

                    <TableColumn fx:id="colRefund"
                                 text="Refund"
                                 prefWidth="110"/>

                    <TableColumn fx:id="colStatus"
                                 text="Status"
                                 prefWidth="140"/>

                </columns>

            </TableView>

        </VBox>

    </HBox>


    <!-- ===================================================== -->
    <!-- CARD BUTTON -->
    <!-- ===================================================== -->

    <HBox spacing="12"
          AnchorPane.leftAnchor="30"
          AnchorPane.rightAnchor="30"
          AnchorPane.bottomAnchor="20"
          style="-fx-background-color: #FFFDF7;
                 -fx-background-radius: 20;
                 -fx-border-radius: 20;">

        <padding>
            <Insets top="15"
                    right="20"
                    bottom="15"
                    left="20"/>
        </padding>

        <Button fx:id="btnSimpan"
                text="Simpan"
                onAction="#handleSimpan"
                prefWidth="100"/>

        <Button fx:id="btnUbah"
                text="Ubah"
                onAction="#handleUbah"
                prefWidth="100"/>

        <Button fx:id="btnHapus"
                text="Batalkan"
                onAction="#handleHapus"
                prefWidth="100"/>

        <Button fx:id="btnReset"
                text="Reset"
                onAction="#handleReset"
                prefWidth="100"/>

        <Button fx:id="btnCetak"
                text="Cetak Struk"
                onAction="#handleCetakStruk"
                prefWidth="110"/>

    </HBox>

</AnchorPane>