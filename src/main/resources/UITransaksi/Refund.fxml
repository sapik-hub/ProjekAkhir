<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ProjekAstra.Controller.Transaksi.Refund"
            prefWidth="960" prefHeight="640">

    <top>
        <VBox spacing="5" BorderPane.alignment="CENTER">
            <padding><Insets top="15" right="20" bottom="10" left="20"/></padding>
            <Label text="Transaksi Refund" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Separator/>
        </VBox>
    </top>

    <center>
        <VBox spacing="15">
            <padding><Insets top="10" right="20" bottom="10" left="20"/></padding>

            <!-- ===== FORM ===== -->
            <GridPane hgap="12" vgap="10">
                <columnConstraints>
                    <ColumnConstraints minWidth="120"/>
                    <ColumnConstraints minWidth="220"/>
                    <ColumnConstraints minWidth="120"/>
                    <ColumnConstraints minWidth="220"/>
                </columnConstraints>

                <Label text="Id Refund" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="txtId" editable="false" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Karyawan" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                <ComboBox fx:id="cbKaryawan" promptText="Pilih Karyawan" maxWidth="Infinity"
                          GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                <Label text="Booking" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <ComboBox fx:id="cbBooking" promptText="Pilih Booking" maxWidth="Infinity"
                          GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="Status" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                <ComboBox fx:id="cbStatus" promptText="Pilih Status" maxWidth="Infinity"
                          GridPane.rowIndex="1" GridPane.columnIndex="3"/>

                <Label text="Jumlah Refund" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="txtJumlahRefund" promptText="0" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Tanggal Pengajuan" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
                <DatePicker fx:id="dpPengajuan" maxWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="3"/>

                <Label text="Tanggal Refund" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <DatePicker fx:id="dpRefund" maxWidth="Infinity" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label text="Alasan Refund" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <TextArea fx:id="txtAlasan" prefRowCount="2" wrapText="true"
                          GridPane.rowIndex="4" GridPane.columnIndex="1" GridPane.columnSpan="3"/>

                <Label text="Deskripsi" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                <TextArea fx:id="txtDeskripsi" prefRowCount="2" wrapText="true"
                          GridPane.rowIndex="5" GridPane.columnIndex="1" GridPane.columnSpan="3"/>
            </GridPane>

            <!-- ===== TOMBOL AKSI ===== -->
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button fx:id="btnSimpan" text="Simpan" onAction="#handleSimpan" defaultButton="true"/>
                <Button fx:id="btnUbah" text="Ubah" onAction="#handleUbah" disable="true"/>
                <Button fx:id="btnHapus" text="Batalkan" onAction="#handleHapus" disable="true"/>
                <Button text="Reset" onAction="#handleReset"/>
            </HBox>

            <Separator/>

            <!-- ===== PENCARIAN ===== -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Cari:"/>
                <TextField fx:id="txtCari" promptText="Cari berdasarkan Id Refund / Nama Karyawan / Id Booking" HBox.hgrow="ALWAYS"/>
            </HBox>

            <!-- ===== TABEL ===== -->
            <TableView fx:id="tableRefund" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="Id Refund" prefWidth="110"/>
                    <TableColumn fx:id="colKaryawan" text="Karyawan" prefWidth="130"/>
                    <TableColumn fx:id="colBooking" text="Id Booking" prefWidth="100"/>
                    <TableColumn fx:id="colAlasan" text="Alasan" prefWidth="150"/>
                    <TableColumn fx:id="colJumlah" text="Jumlah Refund" prefWidth="110"/>
                    <TableColumn fx:id="colTglPengajuan" text="Tgl Pengajuan" prefWidth="110"/>
                    <TableColumn fx:id="colTglRefund" text="Tgl Refund" prefWidth="110"/>
                    <TableColumn fx:id="colDeskripsi" text="Deskripsi" prefWidth="150"/>
                    <TableColumn fx:id="colStatus" text="Status" prefWidth="110"/>
                </columns>
            </TableView>

        </VBox>
    </center>

</BorderPane>