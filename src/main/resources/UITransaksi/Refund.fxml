<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ProjekAstra.Controller.Transaksi.Refund"
            styleClass="bg-soft"
            stylesheets="@../css/villa-theme.css">

    <center>
        <HBox spacing="15">
            <padding><Insets top="0" bottom="15" left="0" right="0"/></padding>

            <VBox spacing="10" prefWidth="290" styleClass="card">
                <padding><Insets top="20" bottom="20" left="20" right="20"/></padding>

                <Label text="Form Refund" styleClass="brand-title">
                    <font><Font name="System Bold" size="15"/></font>
                </Label>

                <TextField fx:id="txtId" promptText="ID Refund" editable="false" styleClass="input-field"/>
                <ComboBox fx:id="cbBooking" promptText="Pilih Booking (bisa direfund)" maxWidth="Infinity" styleClass="input-field"/>
                <TextField fx:id="txtPenyewa" promptText="Penyewa" editable="false" styleClass="input-field"/>
                <TextField fx:id="txtVilla" promptText="Villa" editable="false" styleClass="input-field"/>
                <TextField fx:id="txtGrandHarga" promptText="Estimasi Jumlah Refund" editable="false" styleClass="input-field"/>
                <TextField fx:id="txtDiprosesOleh" promptText="Diproses Oleh" editable="false" styleClass="input-field"/>

                <TextArea fx:id="txtAlasan" promptText="Alasan Refund" prefRowCount="3" wrapText="true" styleClass="input-field"/>
                <TextArea fx:id="txtDeskripsi" promptText="Deskripsi (opsional)" prefRowCount="2" wrapText="true" styleClass="input-field"/>

                <Label text="Status Transaksi" style="-fx-font-size: 11px; -fx-text-fill: #6b6b6b;"/>
                <ComboBox fx:id="cbStatus" promptText="Status Refund" maxWidth="Infinity" styleClass="input-field"/>

                <Label text="Tanggal Pengajuan" style="-fx-font-size: 11px; -fx-text-fill: #6b6b6b;"/>
                <DatePicker fx:id="dpTglPengajuan" maxWidth="Infinity" styleClass="input-field"/>

                <Label text="Tanggal Refund" style="-fx-font-size: 11px; -fx-text-fill: #6b6b6b;"/>
                <DatePicker fx:id="dpTglRefund" maxWidth="Infinity" styleClass="input-field"/>

                <Region VBox.vgrow="ALWAYS"/>
                <TextField fx:id="txtCari" promptText="🔍 Cari refund..." styleClass="input-field"/>
            </VBox>

            <VBox HBox.hgrow="ALWAYS" styleClass="card">
                <padding><Insets top="15" bottom="15" left="15" right="15"/></padding>

                <TableView fx:id="tableRefund" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" text="ID Refund" prefWidth="90"/>
                        <TableColumn fx:id="colBooking" text="ID Booking" prefWidth="90"/>
                        <TableColumn fx:id="colPenyewa" text="Penyewa" prefWidth="110"/>
                        <TableColumn fx:id="colVilla" text="Villa" prefWidth="110"/>
                        <TableColumn fx:id="colKaryawan" text="Diproses Oleh" prefWidth="110"/>
                        <TableColumn fx:id="colAlasan" text="Alasan" prefWidth="140"/>
                        <TableColumn fx:id="colJumlah" text="Jumlah Refund" prefWidth="120"/>
                        <TableColumn fx:id="colTglPengajuan" text="Tgl Pengajuan" prefWidth="100"/>
                        <TableColumn fx:id="colTglRefund" text="Tgl Refund" prefWidth="100"/>
                        <TableColumn fx:id="colStatus" text="Status" prefWidth="100"/>
                    </columns>
                </TableView>
            </VBox>
        </HBox>
    </center>

    <bottom>
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="card">
            <padding><Insets top="15" bottom="15" left="20" right="20"/></padding>

            <Button fx:id="btnSimpan" text="Simpan" onAction="#handleSimpan" styleClass="btn-primary" prefWidth="100"/>
            <Button fx:id="btnUbah" text="Ubah" onAction="#handleUbah" styleClass="btn-warning" prefWidth="100"/>
            <Button fx:id="btnHapus" text="Batalkan" onAction="#handleHapus" styleClass="btn-danger" prefWidth="100"/>
            <Button text="Reset" onAction="#handleReset" styleClass="btn-neutral" prefWidth="100"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button fx:id="btnCetak" text="🖨 Cetak Bukti Refund" onAction="#handleCetakRefund" styleClass="btn-primary" prefWidth="160"/>
        </HBox>
    </bottom>

</BorderPane>