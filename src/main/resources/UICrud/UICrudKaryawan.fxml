<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ProjekAstra.Controller.Master.CrudKaryawan"
            styleClass="bg-soft"
            stylesheets="@../css/villa-theme.css">

    <center>
        <HBox spacing="15">
            <padding><Insets top="0" bottom="15" left="0" right="0"/></padding>

            <!-- FORM INPUT -->
            <ScrollPane fitToWidth="true" prefWidth="320" styleClass="card" hbarPolicy="NEVER">
                <VBox spacing="10">
                    <padding><Insets top="20" bottom="20" left="20" right="20"/></padding>

                    <Label text="👤 Form Karyawan" styleClass="brand-title">
                        <font><Font name="System Bold" size="15"/></font>
                    </Label>

                    <TextField fx:id="txtId" promptText="ID Karyawan" editable="false" styleClass="input-field"/>
                    <TextField fx:id="txtNama" promptText="Nama Lengkap" styleClass="input-field"/>
                    <TextField fx:id="txtNoTelp" promptText="No. Telepon" styleClass="input-field"/>

                    <HBox spacing="10">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Tanggal Lahir" styleClass="label-regular"/>
                            <DatePicker fx:id="dpTanggalLahir" promptText="Tanggal Lahir" maxWidth="Infinity" styleClass="input-field"/>
                        </VBox>
                        <VBox spacing="5" prefWidth="80">
                            <Label text="Umur" styleClass="label-regular"/>
                            <TextField fx:id="txtUmur" promptText="Umur" styleClass="input-field" editable="false"/>
                        </VBox>
                    </HBox>

                    <TextArea fx:id="txtAlamat" promptText="Alamat" prefRowCount="2" wrapText="true" styleClass="input-field"/>

                    <Separator/>
                    <Label text="Akun Login" styleClass="welcome-text" style="-fx-font-weight: bold;"/>

                    <TextField fx:id="txtUsername" promptText="Username" styleClass="input-field"/>
                    <PasswordField fx:id="txtPassword" promptText="Password" styleClass="input-field"/>

                    <HBox spacing="10">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Tanggal Masuk" styleClass="label-regular"/>
                            <DatePicker fx:id="dpTanggalMasuk" promptText="Tanggal Masuk" maxWidth="Infinity" styleClass="input-field"/>
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Role" styleClass="label-regular"/>
                            <ComboBox fx:id="cbRole" promptText="Role" maxWidth="Infinity" styleClass="input-field"/>
                        </VBox>
                    </HBox>

                    <Label text="Status" styleClass="detail-label-kecil"/>
                    <Label fx:id="lblStatus" text="-" styleClass="detail-harga"/>

                    <Region VBox.vgrow="ALWAYS"/>
                    <TextField fx:id="txtCari" promptText="🔍 Cari nama / id karyawan..." styleClass="input-field"/>
                </VBox>
            </ScrollPane>

            <!-- TABLE -->
            <VBox HBox.hgrow="ALWAYS" styleClass="card">
                <padding><Insets top="15" bottom="15" left="15" right="15"/></padding>

                <TableView fx:id="tableKaryawan" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" text="ID Karyawan" prefWidth="100"/>
                        <TableColumn fx:id="colNama" text="Nama" prefWidth="150"/>
                        <TableColumn fx:id="colNoTelp" text="No. Telp" prefWidth="120"/>
                        <TableColumn fx:id="colUmur" text="Umur" prefWidth="60"/>
                        <TableColumn fx:id="colAlamat" text="Alamat" prefWidth="180"/>
                        <TableColumn fx:id="colTglLahir" text="Tgl Lahir" prefWidth="100"/>
                        <TableColumn fx:id="colUsername" text="Username" prefWidth="110"/>
                        <TableColumn fx:id="colTglMasuk" text="Tgl Masuk" prefWidth="100"/>
                        <TableColumn fx:id="colRole" text="Role" prefWidth="90"/>
                        <TableColumn fx:id="colStatus" text="Status" prefWidth="90"/>
                    </columns>
                </TableView>
            </VBox>
        </HBox>
    </center>

    <bottom>
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="card">
            <padding><Insets top="15" bottom="15" left="20" right="20"/></padding>

            <Button fx:id="btnSimpan" text="Simpan" onAction="#handleSimpan"
                    styleClass="btn-primary" prefWidth="100"/>
            <Button fx:id="btnUbah" text="Ubah" onAction="#handleUbah"
                    styleClass="btn-warning" prefWidth="100"/>
            <Button fx:id="btnHapus" text="Nonaktifkan" onAction="#handleHapus"
                    styleClass="btn-danger" prefWidth="110"/>
            <Button text="Reset" onAction="#handleReset"
                    styleClass="btn-neutral" prefWidth="100"/>
        </HBox>
    </bottom>

</BorderPane>