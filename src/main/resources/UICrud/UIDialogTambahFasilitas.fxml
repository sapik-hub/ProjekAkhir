<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ProjekAstra.Controller.Master.DialogTambahFasilitas"
      styleClass="bg-soft"
      stylesheets="@../css/villa-theme.css"
      spacing="15" prefWidth="400">

    <padding><Insets top="20" bottom="20" left="20" right="20"/></padding>

    <Label text="Tambah Fasilitas Villa" styleClass="brand-title">
        <font><Font name="System Bold" size="16"/></font>
    </Label>

    <ComboBox fx:id="cbFasilitas" promptText="Pilih Fasilitas" maxWidth="Infinity" styleClass="input-field"/>
    <TextField fx:id="txtQty" promptText="Jumlah" styleClass="input-field"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button fx:id="btnBatal" text="Batal" onAction="#handleBatal" styleClass="btn-neutral" prefWidth="100"/>
        <Button fx:id="btnSimpanFasilitas" text="Simpan" onAction="#handleSimpan" styleClass="btn-primary" prefWidth="100"/>
    </HBox>

</VBox>