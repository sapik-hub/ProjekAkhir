<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
			  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
			  xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
			  name="LaporanBooking" language="java" pageWidth="842" pageHeight="595"
			  orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20"
			  topMargin="20" bottomMargin="20">

	<queryString>
		<![CDATA[
			SELECT
				b.Id_TrxBooking,
				p.Nama AS NamaPenyewa,
				v.Nama_Villa,
				k.Nama_Karyawan,
				b.Tanggal_Checkin,
				b.Tanggal_Checkout,
				b.Jumlah_Tamu,
				b.Grand_Harga,
				b.Tanggal_Booking,
				b.Status_Booking
			FROM TransaksiBooking b
			JOIN Penyewa p ON b.Id_Penyewa = p.Id_Penyewa
			JOIN Villa v ON b.Id_Villa = v.Id_Villa
			LEFT JOIN Karyawan k ON b.Id_Karyawan = k.Id_Karyawan
			ORDER BY b.Tanggal_Booking DESC
		]]>
	</queryString>

	<field name="Id_TrxBooking" class="java.lang.String"/>
	<field name="NamaPenyewa" class="java.lang.String"/>
	<field name="Nama_Villa" class="java.lang.String"/>
	<field name="Nama_Karyawan" class="java.lang.String"/>
	<field name="Tanggal_Checkin" class="java.sql.Date"/>
	<field name="Tanggal_Checkout" class="java.sql.Date"/>
	<field name="Jumlah_Tamu" class="java.lang.Integer"/>
	<field name="Grand_Harga" class="java.math.BigDecimal"/>
	<field name="Tanggal_Booking" class="java.sql.Date"/>
	<field name="Status_Booking" class="java.lang.String"/>

	<variable name="TotalBooking" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{Grand_Harga}]]></variableExpression>
	</variable>

	<background>
		<band splitType="Stretch"/>
	</background>

	<title>
		<band height="60" splitType="Stretch">
			<staticText>
				<reportElement x="311" y="5" width="238" height="50"/>
				<textElement textAlignment="Center">
					<font fontName="Times New Roman" size="12"/>
				</textElement>
				<text><![CDATA[VILLANESIA
      Jl. Mawar No.25 Jakarta Selatan
      Telp (021)12345678]]></text>
			</staticText>
		</band>
	</title>

	<pageHeader>
		<band height="70" splitType="Stretch">
			<staticText>
				<reportElement x="200" y="5" width="460" height="30"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="18" isBold="true"/>
				</textElement>
				<text><![CDATA[LAPORAN TRANSAKSI BOOKING SEWA VILLA]]></text>
			</staticText>
			<staticText>
				<reportElement x="20" y="40" width="270" height="25"/>
				<textElement>
					<font fontName="Times New Roman"/>
				</textElement>
				<text><![CDATA[Tanggal Cetak :
Dicetak Oleh  : Admin]]></text>
			</staticText>
			<textField pattern="HH:mm">
				<reportElement x="100" y="40" width="100" height="25"/>
				<textElement>
					<font fontName="Times New Roman"/>
				</textElement>
				<textFieldExpression class="java.util.Date"><![CDATA[new java.util.Date()]]></textFieldExpression>
			</textField>
			<textField pattern="HH:mm">
				<reportElement x="181" y="40" width="100" height="25"/>
				<textElement>
					<font fontName="Times New Roman"/>
				</textElement>
				<textFieldExpression class="java.util.Date"><![CDATA[new java.util.Date()]]></textFieldExpression>
			</textField>
		</band>
	</pageHeader>

	<columnHeader>
		<band height="30" splitType="Stretch">
			<staticText>
				<reportElement mode="Opaque" x="0" y="0" width="70" height="30" backcolor="#FFFF99"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman"/>
				</textElement>
				<text><![CDATA[Id Booking]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="70" y="0" width="90" height="30" backcolor="#FFFF99"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman"/>
				</textElement>
				<text><![CDATA[Penyewa]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="160" y="0" width="90" height="30" backcolor="#FFFF99"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman"/>
				</textElement>
				<text><![CDATA[Villa]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="250" y="0" width="80" height="30" backcolor="#FFFF99"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman"/>
				</textElement>
				<text><![CDATA[Check-In]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="330" y="0" width="80" height="30" backcolor="#FFFF99"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman"/>
				</textElement>
				<text><![CDATA[Check-Out]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="410" y="0" width="50" height="30" backcolor="#FFFF99"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman"/>
				</textElement>
				<text><![CDATA[Tamu]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="460" y="0" width="90" height="30" backcolor="#FFFF99"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman"/>
				</textElement>
				<text><![CDATA[Grand Harga]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="550" y="0" width="90" height="30" backcolor="#FFFF99"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman"/>
				</textElement>
				<text><![CDATA[Status]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="640" y="0" width="90" height="30" backcolor="#FFFF99"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman"/>
				</textElement>
				<text><![CDATA[Dikonfirmasi Oleh]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="730" y="0" width="70" height="30" backcolor="#FFFF99"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman"/>
				</textElement>
				<text><![CDATA[Tgl Booking]]></text>
			</staticText>
		</band>
	</columnHeader>

	<detail>
		<band height="30" splitType="Stretch">
			<textField>
				<reportElement x="0" y="0" width="70" height="30"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{Id_TrxBooking}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="70" y="0" width="90" height="30"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{NamaPenyewa}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="160" y="0" width="90" height="30"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{Nama_Villa}]]></textFieldExpression>
			</textField>
			<textField pattern="dd-MM-yyyy">
				<reportElement x="250" y="0" width="80" height="30"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman"/>
				</textElement>
				<textFieldExpression class="java.sql.Date"><![CDATA[$F{Tanggal_Checkin}]]></textFieldExpression>
			</textField>
			<textField pattern="dd-MM-yyyy">
				<reportElement x="330" y="0" width="80" height="30"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman"/>
				</textElement>
				<textFieldExpression class="java.sql.Date"><![CDATA[$F{Tanggal_Checkout}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="410" y="0" width="50" height="30"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman"/>
				</textElement>
				<textFieldExpression class="java.lang.Integer"><![CDATA[$F{Jumlah_Tamu}]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0">
				<reportElement x="460" y="0" width="90" height="30"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman"/>
				</textElement>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{Grand_Harga}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="550" y="0" width="90" height="30"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{Status_Booking}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="640" y="0" width="90" height="30"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{Nama_Karyawan} == null ? "-" : $F{Nama_Karyawan}]]></textFieldExpression>
			</textField>
			<textField pattern="dd-MM-yyyy">
				<reportElement x="730" y="0" width="70" height="30"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman"/>
				</textElement>
				<textFieldExpression class="java.sql.Date"><![CDATA[$F{Tanggal_Booking}]]></textFieldExpression>
			</textField>
		</band>
	</detail>

	<columnFooter>
		<band height="45" splitType="Stretch">
			<staticText>
				<reportElement x="600" y="7" width="100" height="30"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="Times New Roman"/>
				</textElement>
				<text><![CDATA[Total Transaksi:]]></text>
			</staticText>
			<textField pattern="#,##0">
				<reportElement x="705" y="7" width="97" height="30"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="Times New Roman" isBold="true"/>
				</textElement>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$V{TotalBooking}]]></textFieldExpression>
			</textField>
		</band>
	</columnFooter>

	<pageFooter>
		<band height="40" splitType="Stretch">
			<staticText>
				<reportElement x="0" y="10" width="100" height="30"/>
				<textElement>
					<font fontName="Times New Roman"/>
				</textElement>
				<text><![CDATA[Di cetak pada: ]]></text>
			</staticText>
			<textField pattern="MMMMM dd, yyyy">
				<reportElement x="70" y="10" width="100" height="30"/>
				<textElement>
					<font fontName="Times New Roman"/>
				</textElement>
				<textFieldExpression class="java.util.Date"><![CDATA[new java.util.Date()]]></textFieldExpression>
			</textField>
			<textField pattern="HH:mm">
				<reportElement x="160" y="10" width="100" height="30"/>
				<textElement>
					<font fontName="Times New Roman"/>
				</textElement>
				<textFieldExpression class="java.util.Date"><![CDATA[new java.util.Date()]]></textFieldExpression>
			</textField>
		</band>
	</pageFooter>

	<summary>
		<band height="42" splitType="Stretch">
			<textField evaluationTime="Report">
				<reportElement x="12" y="8" width="100" height="30"/>
				<textElement>
					<font fontName="Times New Roman"/>
				</textElement>
				<textFieldExpression class="java.lang.Integer"><![CDATA[$V{PAGE_NUMBER}]]></textFieldExpression>
			</textField>
		</band>
	</summary>

</jasperReport>