<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
			  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
			  xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
			  name="LapRefundLandscape" language="java" pageWidth="842" pageHeight="595"
			  orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20"
			  topMargin="20" bottomMargin="20">

	<queryString>
		<![CDATA[
			SELECT
				r.Id_TrxRefund,
				r.Id_TrxBooking,
				p.Nama AS NamaPenyewa,
				v.Nama_Villa,
				k.Nama_Karyawan,
				r.Alasan_Refund,
				r.Jumlah_Refund,
				r.Tanggal_Pengajuan,
				r.Tanggal_Refund,
				r.Deskripsi,
				r.Status
			FROM TransaksiRefund r
			JOIN TransaksiBooking b ON r.Id_TrxBooking = b.Id_TrxBooking
			JOIN Penyewa p ON b.Id_Penyewa = p.Id_Penyewa
			JOIN Villa v ON b.Id_Villa = v.Id_Villa
			JOIN Karyawan k ON r.Id_Karyawan = k.Id_Karyawan
			ORDER BY r.Tanggal_Pengajuan DESC
		]]>
	</queryString>

	<field name="Id_TrxRefund" class="java.lang.String"/>
	<field name="Id_TrxBooking" class="java.lang.String"/>
	<field name="NamaPenyewa" class="java.lang.String"/>
	<field name="Nama_Villa" class="java.lang.String"/>
	<field name="Nama_Karyawan" class="java.lang.String"/>
	<field name="Alasan_Refund" class="java.lang.String"/>
	<field name="Jumlah_Refund" class="java.math.BigDecimal"/>
	<field name="Tanggal_Pengajuan" class="java.sql.Date"/>
	<field name="Tanggal_Refund" class="java.sql.Date"/>
	<field name="Deskripsi" class="java.lang.String"/>
	<field name="Status" class="java.lang.String"/>

	<variable name="TotalRefund" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{Jumlah_Refund}]]></variableExpression>
	</variable>

	<background>
		<band splitType="Stretch"/>
	</background>

	<title>
		<band height="60" splitType="Stretch">
			<staticText>
				<reportElement x="311" y="5" width="238" height="50"/>
				<textElement textAlignment="Center">
					<font fontName="Times New Roman" size="12"/>
				</textElement>
				<text><![CDATA[VILLANESIA
      Jl. Mawar No.25 Jakarta Selatan
      Telp (021)12345678]]></text>
			</staticText>
		</band>
	</title>

	<pageHeader>
		<band height="70" splitType="Stretch">
			<staticText>
				<reportElement x="200" y="5" width="460" height="30"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="18" isBold="true"/>
				</textElement>
				<text><![CDATA[LAPORAN TRANSAKSI REFUND SEWA VILLA]]></text>
			</staticText>
			<staticText>
				<reportElement x="20" y="40" width="270" height="25"/>
				<textElement>
					<font fontName="Times New Roman"/>
				</textElement>
				<text><![CDATA[Tanggal Cetak :
Dicetak Oleh  : Admin]]></text>
			</staticText>
			<textField pattern="HH:mm">
				<reportElement x="100" y="40" width="100" height="25"/>
				<textElement>
					<font fontName="Times New Roman"/>
				</textElement>
				<textFieldExpression class="java.util.Date"><![CDATA[new java.util.Date()]]></textFieldExpression>
			</textField>
			<textField pattern="HH:mm">
				<reportElement x="181" y="40" width="100" height="25"/>
				<textElement>
					<font fontName="Times New Roman"/>
				</textElement>
				<textFieldExpression class="java.util.Date"><![CDATA[new java.util.Date()]]></textFieldExpression>
			</textField>
		</band>
	</pageHeader>

	<columnHeader>
		<band height="30" splitType="Stretch">
			<staticText>
				<reportElement mode="Opaque" x="0" y="0" width="70" height="30" backcolor="#FFFF99"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman"/>
				</textElement>
				<text><![CDATA[Id Refund]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="70" y="0" width="70" height="30" backcolor="#FFFF99"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman"/>
				</textElement>
				<text><![CDATA[Id Booking]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="140" y="0" width="90" height="30" backcolor="#FFFF99"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman"/>
				</textElement>
				<text><![CDATA[Penyewa]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="230" y="0" width="90" height="30" backcolor="#FFFF99"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman"/>
				</textElement>
				<text><![CDATA[Villa]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="320" y="0" width="90" height="30" backcolor="#FFFF99"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman"/>
				</textElement>
				<text><![CDATA[Diproses Oleh]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="410" y="0" width="100" height="30" backcolor="#FFFF99"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman"/>
				</textElement>
				<text><![CDATA[Alasan Refund]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="510" y="0" width="90" height="30" backcolor="#FFFF99"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman"/>
				</textElement>
				<text><![CDATA[Jumlah Refund]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="600" y="0" width="80" height="30" backcolor="#FFFF99"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman"/>
				</textElement>
				<text><![CDATA[Tgl Pengajuan]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="680" y="0" width="70" height="30" backcolor="#FFFF99"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman"/>
				</textElement>
				<text><![CDATA[Tgl Refund]]></text>
			</staticText>
			<staticText>
				<reportElement mode="Opaque" x="750" y="0" width="52" height="30" backcolor="#FFFF99"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman"/>
				</textElement>
				<text><![CDATA[Status]]></text>
			</staticText>
		</band>
	</columnHeader>

	<detail>
		<band height="30" splitType="Stretch">
			<textField>
				<reportElement x="0" y="0" width="70" height="30"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{Id_TrxRefund}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="70" y="0" width="70" height="30"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{Id_TrxBooking}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="140" y="0" width="90" height="30"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{NamaPenyewa}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="230" y="0" width="90" height="30"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{Nama_Villa}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="320" y="0" width="90" height="30"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{Nama_Karyawan}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="410" y="0" width="100" height="30"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{Alasan_Refund}]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0">
				<reportElement x="510" y="0" width="90" height="30"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman"/>
				</textElement>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$F{Jumlah_Refund}]]></textFieldExpression>
			</textField>
			<textField pattern="dd-MM-yyyy">
				<reportElement x="600" y="0" width="80" height="30"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman"/>
				</textElement>
				<textFieldExpression class="java.sql.Date"><![CDATA[$F{Tanggal_Pengajuan}]]></textFieldExpression>
			</textField>
			<textField pattern="dd-MM-yyyy">
				<reportElement x="680" y="0" width="70" height="30"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman"/>
				</textElement>
				<textFieldExpression class="java.sql.Date"><![CDATA[$F{Tanggal_Refund}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="750" y="0" width="52" height="30"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{Status}]]></textFieldExpression>
			</textField>
		</band>
	</detail>

	<columnFooter>
		<band height="45" splitType="Stretch">
			<staticText>
				<reportElement x="600" y="7" width="100" height="30"/>
