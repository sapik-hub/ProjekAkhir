					<font fontName="Times New Roman"/>
				</textElement>
				<text><![CDATA[Total Transaksi:]]></text>
			</staticText>
			<textField pattern="#,##0">
				<reportElement x="705" y="7" width="97" height="30"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="Times New Roman" isBold="true"/>
				</textElement>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$V{TotalRefund}]]></textFieldExpression>
			</textField>
		</band>
